# Neon Postgres — ambil pooled connection string dari Neon/Vercel Marketplace
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Endpoint /api/cron dan /api/admin/retry wajib menerima Authorization: Bearer <nilai ini>
CRON_SECRET=ganti-dengan-random-secret-minimal-32-karakter

# Penyedia AI berurutan: Groq → Gemini → Gemini cadangan
GROQ_API_KEY=
# Opsional: preferensi; otomatis memilih model yang tersedia jika kosong
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
# Opsional: preferensi; otomatis memilih model yang tersedia jika kosong
GEMINI_MODEL=

# Buffer API — aplikasi mengantrekan post; Buffer menerbitkannya sesuai jadwal channel.
BUFFER_API_KEY=
BUFFER_NEWS_CHANNEL_ID=
BUFFER_ENTERTAINMENT_CHANNEL_ID=

# Facebook Graph API.
# Halaman berita tetap memakai Buffer; kredensial berita hanya untuk mengulang komentar sumber.
# Isi FB_ENTERTAINMENT_PAGE_ID + FB_ENTERTAINMENT_PAGE_ACCESS_TOKEN (token halaman berumur panjang)
# agar halaman hiburan Popbeez menerbitkan langsung ke Facebook tanpa Buffer.
# Jika dua variabel hiburan itu kosong, halaman hiburan otomatis kembali memakai Buffer.
FB_NEWS_PAGE_ID=
FB_NEWS_PAGE_ACCESS_TOKEN=
FB_ENTERTAINMENT_PAGE_ID=
FB_ENTERTAINMENT_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v23.0

# URL publik deployment (tanpa slash di akhir), diperlukan untuk URL gambar news card
APP_URL=https://nama-proyek.vercel.app
# Opsional: domain pendek sendiri yang diarahkan ke project Vercel ini (HTTPS, tanpa slash).
# Jika kosong, short link memakai APP_URL. Jalankan drizzle/0009_short_links.sql lebih dulu.
SHORTLINK_BASE_URL=
# Host yang hanya boleh melayani /s/<slug> (aplikasi tetap di APP_URL). Isi "off" untuk mematikan batas ini.
SHORTLINK_ONLY_HOST=popbeez.hivecomp.my.id
# Otomatis ditambahkan ke project setelah menghubungkan Vercel Blob Store
BLOB_READ_WRITE_TOKEN=
PAGE_BRAND_NEWS=Nusabeez
PAGE_BRAND_ENTERTAINMENT=Popbeez
# Opsional: override URL logo per halaman; aset default berada di public/brand. PAGE_LOGO_URL menjadi fallback bersama.
PAGE_LOGO_NEWS_URL=
PAGE_LOGO_ENTERTAINMENT_URL=
PAGE_LOGO_URL=

# Kuis "Tebak Drama": otomatis tiap Minggu 19:15 WITA bila sudah 14 hari sejak edisi terakhir.
# Poster diubah jadi siluet 2D lewat model gambar Gemini (tanpa mata/hidung/mulut & tanpa judul).
# Set QUIZ_SILHOUETTE_AI=0 bila ingin memakai mesin siluet lokal saja.
# Tiap edisi memakai 5 poster acak dari review manual Popbeez; satu poster maksimal 3× dipakai. Ubah interval bila perlu.
QUIZ_INTERVAL_DAYS=14

# Penjaga orisinalitas: caption yang skornya di bawah ambang ini DITAHAN (tidak dikirim ke Facebook).
# Skor 0-100 dihitung dari kemiripan dengan sumber + ada/tidaknya analisis, opini, dan pertanyaan diskusi.
# 0 = matikan penahanan (semua caption lolos), 90 = paling ketat. Bawaan 45.
ORIGINALITY_MIN_SCORE=45
# Berapa draft yang boleh dicoba sebelum post ditahan. 2 = caption yang gagal
# otomatis ditulis ulang sekali dengan brief lebih ketat (tanpa campur tangan admin).
# Biaya AI naik ±2x hanya untuk post yang gagal. Rentang 1-2.
ORIGINALITY_MAX_ATTEMPTS=2

# Reels otomatis: naskah narasi dari artikel hiburan disuarakan Edge TTS (gratis, tanpa API key)
# lalu dirender 1080x1920 dan diposting ke Facebook Reels. 1 = aktif untuk cron, 0 = hanya manual.
REELS_ENABLED=0
# Suara Edge TTS bahasa Indonesia: id-ID-GadisNeural (perempuan) atau id-ID-ArdiNeural (laki-laki).
REELS_TTS_VOICE=id-ID-GadisNeural
# Jeda minimal antar Reel otomatis, dalam jam.
REELS_MIN_GAP_HOURS=20
# Encoder video. Pilih salah satu:
# 1) FFMPEG_PATH=/usr/bin/ffmpeg  (server ini punya ffmpeg)
# 2) REELS_RENDER_URL=https://vps-contoh:8080 + REELS_WORKER_TOKEN=... (worker scripts/reels-render-worker.mjs di VPS)
FFMPEG_PATH=
REELS_RENDER_URL=
REELS_WORKER_TOKEN=

# Jadwal tayang otomatis memakai jam WITA (UTC+8). Kosong = 16 slot bawaan:
# 06:45, 07:45, 08:45, 09:45, 10:45, 11:45, 13:15, 14:15, 16:15, 17:15, 18:15, 19:15, 20:15, 20:45, 21:15, 21:45
# Isi daftar sendiri (mis. "08:00,12:30") atau "off" untuk menerbitkan setiap kali cron berjalan.
PUBLISH_SLOTS_WITA=
# Toleransi setelah jam slot, dalam menit. Cron berjalan tiap 15 menit, jadi 14 adalah nilai aman.
PUBLISH_SLOT_GRACE_MINUTES=14

# Sumber RSS dikelola dari Dashboard aplikasi setelah masuk, bukan dari environment variables.

# Model gambar untuk mengubah poster jadi siluet kuis (butuh GEMINI_API_KEY).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
