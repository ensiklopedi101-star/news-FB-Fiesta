# Neon Postgres — ambil pooled connection string dari Neon/Vercel Marketplace
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Endpoint /api/cron dan /api/admin/retry wajib menerima Authorization: Bearer <nilai ini>
CRON_SECRET=ganti-dengan-random-secret-minimal-32-karakter

# Google AI Studio / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Facebook Page Graph API — gunakan Page Access Token dengan permission yang sesuai.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Tetapkan versi Graph API yang masih didukung Meta, contoh v23.0
FB_GRAPH_VERSION=v23.0

# URL publik deployment (tanpa slash di akhir), diperlukan untuk URL gambar news card
APP_URL=https://nama-proyek.vercel.app
PAGE_BRAND=Kabar Nusra
# Opsional: URL HTTPS publik logo halaman (dipakai di news card)
PAGE_LOGO_URL=

# JSON array feed RSS. Sesuaikan URL feed dengan sumber yang benar-benar kamu gunakan.
# Kategori yang disarankan: BALI, NTB, NTT, DRAKOR, DRACIN
NEWS_FEEDS=[{"name":"Antara Bali","category":"BALI","url":"https://contoh.id/rss.xml","language":"id"},{"name":"Soompi","category":"DRAKOR","url":"https://contoh.id/soompi.xml","language":"en"}]

# Batas maksimal item yang dipindai dari tiap feed per pemanggilan cron (1-20)
MAX_ITEMS_PER_FEED=8
