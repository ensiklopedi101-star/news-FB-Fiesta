# Neon Postgres — ambil pooled connection string dari Neon/Vercel Marketplace
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Endpoint /api/cron dan /api/admin/retry wajib menerima Authorization: Bearer <nilai ini>
CRON_SECRET=ganti-dengan-random-secret-minimal-32-karakter

# Penyedia AI berurutan: Groq → Gemini → Gemini cadangan
GROQ_API_KEY=
# Opsional: preferensi; otomatis memilih model yang tersedia jika kosong
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
# Opsional: preferensi; otomatis memilih model yang tersedia jika kosong
GEMINI_MODEL=

# Buffer API — aplikasi mengantrekan post; Buffer menerbitkannya sesuai jadwal channel.
BUFFER_API_KEY=
BUFFER_NEWS_CHANNEL_ID=
BUFFER_ENTERTAINMENT_CHANNEL_ID=

# Facebook Graph API.
# Halaman berita tetap memakai Buffer; kredensial berita hanya untuk mengulang komentar sumber.
# Isi FB_ENTERTAINMENT_PAGE_ID + FB_ENTERTAINMENT_PAGE_ACCESS_TOKEN (token halaman berumur panjang)
# agar halaman hiburan Popbeez menerbitkan langsung ke Facebook tanpa Buffer.
# Jika dua variabel hiburan itu kosong, halaman hiburan otomatis kembali memakai Buffer.
FB_NEWS_PAGE_ID=
FB_NEWS_PAGE_ACCESS_TOKEN=
FB_ENTERTAINMENT_PAGE_ID=
FB_ENTERTAINMENT_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v23.0

# URL publik deployment (tanpa slash di akhir), diperlukan untuk URL gambar news card
APP_URL=https://nama-proyek.vercel.app
# Otomatis ditambahkan ke project setelah menghubungkan Vercel Blob Store
BLOB_READ_WRITE_TOKEN=
PAGE_BRAND_NEWS=Nusabeez
PAGE_BRAND_ENTERTAINMENT=Popbeez
# Opsional: override URL logo per halaman; aset default berada di public/brand. PAGE_LOGO_URL menjadi fallback bersama.
PAGE_LOGO_NEWS_URL=
PAGE_LOGO_ENTERTAINMENT_URL=
PAGE_LOGO_URL=

# Sumber RSS dikelola dari Dashboard aplikasi setelah masuk, bukan dari environment variables.
